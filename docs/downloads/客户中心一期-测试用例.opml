<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>客户中心一期 测试用例（脱敏样例）</title>
  </head>
  <body>
    <outline text="客户中心一期 测试用例（脱敏样例）">
      <outline text="2.1 创建客户">
        <outline text="前置查重与入口">
          <outline text="正向-点击创建客户先弹出客户状态查询弹窗">
            <outline text="前置：用户已登录 客户系统 且具备创建客户权限">
            </outline>
            <outline text="步骤：进入客户列表页 → 点击「创建客户」按钮">
            </outline>
            <outline text="预期：不直接打开创建表单，先弹出「客户状态查询」弹窗，标题为「客户状态查询（创建客户前请先查询是否已在系统）」；搜索框为空时底部无可用的「创建客户」按钮（BR-002）">
            </outline>
          </outline>
          <outline text="正向-查询未命中时展示空状态并可进入创建">
            <outline text="前置：系统中不存在名称为「测试客户甲」的客户">
            </outline>
            <outline text="步骤：弹窗搜索框输入「测试客户甲」→ 点击「查询」">
            </outline>
            <outline text="预期：展示空状态「暂无此客户，立即创建客户」；「创建客户」按钮可点击；点击后打开创建客户表单浮层">
            </outline>
          </outline>
          <outline text="正向-查到相似客户时展示五条业务线状态与责任BD">
            <outline text="前置：存在客户「某头部视频平台客户」，MTC 合作状态=合作中、责任BD=责任BD-1，PAC 无责任BD">
            </outline>
            <outline text="步骤：搜索「某头部视频平台」→ 点击「查询」">
            </outline>
            <outline text="预期：展示相似列表，含客户名称、MTC/PAC/VASC-DMC/VASC-CMC/VASC-ECP 合作状态与责任BD、操作栏；该行 MTC 显示「合作中」标签与「责任BD-1」，PAC 责任BD 显示「-」（BR-203）">
            </outline>
          </outline>
          <outline text="正向-查到相似客户后仍可继续创建">
            <outline text="前置：查询结果中存在相似客户">
            </outline>
            <outline text="步骤：点击弹窗底部「创建客户」按钮">
            </outline>
            <outline text="预期：直接进入创建表单浮层，无二次拦截提示，后续可正常提交（BR-003）">
            </outline>
          </outline>
          <outline text="反向-未输入客户名称时不提供创建入口">
            <outline text="步骤：打开「客户状态查询」弹窗，不输入任何内容">
            </outline>
            <outline text="预期：不展示可点击的「创建客户」按钮，无法进入创建表单（BR-002）">
            </outline>
          </outline>
          <outline text="反向-查重后关闭弹窗不产生客户记录">
            <outline text="步骤：查到相似客户 → 点击弹窗关闭按钮">
            </outline>
            <outline text="预期：返回客户列表页，客户总数不变，无新增记录">
            </outline>
          </outline>
        </outline>
        <outline text="创建表单字段">
          <outline text="正向-完整填写必填项提交创建成功">
            <outline text="前置：查重无重复；当前用户 BU=MTC，业务类型默认带出 MTC">
            </outline>
            <outline text="步骤：填写客户名称、所属行业、城市、推广计划、人际关系、合作友商、经营现状、产品相关 → 点击「提交」→ 二次确认点「确定」">
            </outline>
            <outline text="预期：Toast「创建成功」；表单浮层关闭；列表刷新且新客户位于列表顶部；客户编号形如 KH-{YYYYMM}{6位序号}（BR-004）；跟进人关系表新增创建人记录且业务线=表单所选业务类型（BR-005）；sync_status=0 待同步">
            </outline>
          </outline>
          <outline text="正向-客户级别类型默认LT且不可选">
            <outline text="步骤：打开创建表单查看「客户级别类型」">
            </outline>
            <outline text="预期：以只读文本展示「LT」，无单选或下拉控件，页面无修改入口">
            </outline>
            <outline text="备注：2.3.2 将同一字段标注为 Radio 枚举 KA/GT/LT，控件口径见待确认 Q2">
            </outline>
          </outline>
          <outline text="正向-客户类型默认直客并可切换代理">
            <outline text="步骤：查看「客户类型」默认选中项 → 点击「代理」">
            </outline>
            <outline text="预期：默认选中「直客」；点击后仅「代理」被选中，「直客」取消选中">
            </outline>
          </outline>
          <outline text="正向-所属行业下拉包含全部10个枚举">
            <outline text="步骤：展开「所属行业」下拉">
            </outline>
            <outline text="预期：依次展示文娱-轻度游戏、文娱-中重度游戏、文娱-社交及影音娱乐、文娱-工具、文娱-阅读、文娱-金融、文娱-其他、消费-电商平台、消费-跨境卖家、消费-行业品牌共10项；控件不支持手动输入">
            </outline>
          </outline>
          <outline text="正向-国家地区默认中国并联动城市必填">
            <outline text="步骤：查看「国家/地区」默认值 → 切换为「美国」→ 展开城市下拉">
            </outline>
            <outline text="预期：默认「中国」；切换为美国后城市必填红星消失，城市下拉仅展示美国城市">
            </outline>
          </outline>
          <outline text="边界-国家非中国时城市留空可提交">
            <outline text="前置：客户名称、所属行业、业务类型、五个文本域均已填写；国家/地区=美国">
            </outline>
            <outline text="步骤：城市不选 → 点击「提交」">
            </outline>
            <outline text="预期：前端校验通过并弹出二次确认弹窗，不出现「请填写城市」提示">
            </outline>
          </outline>
          <outline text="反向-国家为中国时城市未选被拦截">
            <outline text="前置：国家/地区保持默认「中国」">
            </outline>
            <outline text="步骤：城市留空 → 点击「提交」">
            </outline>
            <outline text="预期：城市字段标红并提示「请填写城市」，阻止提交，页面滚动定位到城市字段（BR-006）">
            </outline>
          </outline>
          <outline text="反向-客户官网非URL格式被拦截">
            <outline text="步骤：客户官网输入「abc」→ 点击「提交」">
            </outline>
            <outline text="预期：提示网址格式错误并阻止提交；改为 https://www.abc.com 后可进入二次确认">
            </outline>
            <outline text="备注：PRD 只写「URL格式」未给提示文案，文案口径见待确认 Q16">
            </outline>
          </outline>
          <outline text="正向-客户来源默认市场线索并出现线索选择">
            <outline text="步骤：查看「客户来源」默认值">
            </outline>
            <outline text="预期：默认选中「市场线索」，下方出现必填「线索」选择框，支持按线索名称模糊搜索">
            </outline>
          </outline>
          <outline text="正向-来源切换为非市场线索出现中间人必填项">
            <outline text="步骤：客户来源点击「媒体直客」">
            </outline>
            <outline text="预期：「线索」选择框隐藏；出现「中间人」文本输入框且为必填，占位提示填写中间人姓名和联系方式">
            </outline>
            <outline text="备注：该枚举在 2.3.3 写作「内容资源」，与本节「内部资源」不一致，见待确认 Q1">
            </outline>
          </outline>
          <outline text="反向-中间人为空提交被拦截">
            <outline text="步骤：来源选「老客转介绍」→ 中间人留空 → 点击「提交」">
            </outline>
            <outline text="预期：中间人字段标红并提示必填，阻止提交">
            </outline>
          </outline>
          <outline text="正向-业务类型按BU自动带出默认值">
            <outline text="前置：分别准备 MTC、PAC、BU-A、BU-B、BU-C、BU-D、BU-E、BU-F 各一个账号">
            </outline>
            <outline text="步骤：逐个账号打开创建表单查看「业务类型」">
            </outline>
            <outline text="预期：MTC→MTC、PAC→PAC、BU-A→VASC-CMC、BU-B→VASC-DMC、BU-C→VASC-DMC、BU-D→VASC-ECP；BU-E/BU-F 无默认值，留空提交被拦截">
            </outline>
          </outline>
          <outline text="正向-业务类型下拉包含6个枚举">
            <outline text="步骤：展开「业务类型」下拉">
            </outline>
            <outline text="预期：展示 MTC/PAC/VASC-DMC/VASC-CMC/VASC-ECP/MAAS 共6项，单选">
            </outline>
          </outline>
          <outline text="反向-线索已被其他客户关联时无法重复关联">
            <outline text="前置：线索 L001 已关联客户「A公司」">
            </outline>
            <outline text="步骤：来源=市场线索 → 线索选择框选中 L001">
            </outline>
            <outline text="预期：提示「该线索已被关联A公司客户，无法重复关联」，不写入关联关系，选择框恢复未选状态">
            </outline>
          </outline>
          <outline text="反向-普通用户只能搜索本人及下属的线索">
            <outline text="前置：线索 L002 的跟进人与提供人均为其他部门同事">
            </outline>
            <outline text="步骤：普通用户在线索选择框搜索 L002 名称">
            </outline>
            <outline text="预期：搜索结果不含 L002；本人或下属的线索可正常命中">
            </outline>
          </outline>
          <outline text="正向-admin可搜索全量线索">
            <outline text="前置：使用 admin 权限账号">
            </outline>
            <outline text="步骤：在线索选择框搜索其他部门同事的线索名称">
            </outline>
            <outline text="预期：可命中全量线索，不受跟进人/提供人限制（与上一条构成权限对照）">
            </outline>
          </outline>
          <outline text="反向-五个必填文本域缺失时整单拦截">
            <outline text="步骤：仅填写客户名称 → 点击「提交」">
            </outline>
            <outline text="预期：推广计划、人际关系、合作友商、经营现状、产品相关 五个文本域全部标红，底部提示「请填写推广计划」，阻止提交（BR-006）">
            </outline>
          </outline>
          <outline text="边界-文本域超长内容可完整保存">
            <outline text="前置：其余必填项已填写">
            </outline>
            <outline text="步骤：五个文本域各输入 5000 字符 → 提交并确认创建">
            </outline>
            <outline text="预期：创建成功，详情页对应字段完整展示 5000 字符，无截断、无报错（PRD 标注无长度限制）">
            </outline>
          </outline>
        </outline>
        <outline text="二次确认与提交">
          <outline text="正向-二次确认弹窗取消后返回表单不创建">
            <outline text="步骤：校验通过点「提交」→ 弹窗中点「取消」">
            </outline>
            <outline text="预期：确认弹窗关闭并返回创建表单，已填内容保留；客户列表无新增记录（BR-007）">
            </outline>
          </outline>
          <outline text="正向-二次确认文案与按钮符合定义">
            <outline text="步骤：校验通过点「提交」">
            </outline>
            <outline text="预期：弹窗正文为「确定创建客户?」，含「取消」「确定」两个按钮，「确定」为主按钮">
            </outline>
          </outline>
        </outline>
        <outline text="逆向流程">
          <outline text="正向-取消创建并确认放弃后不保存数据">
            <outline text="步骤：填写部分内容 → 点击「取消」→ 在「确定放弃编辑?」提示中点「确定」">
            </outline>
            <outline text="预期：提示文案为「确定放弃编辑?」；确认后表单关闭且数据不落库；再次打开表单为空">
            </outline>
          </outline>
          <outline text="反向-放弃提示中点取消继续编辑">
            <outline text="步骤：点击「取消」→ 提示中点「取消」">
            </outline>
            <outline text="预期：提示关闭并返回表单，已填内容全部保留可继续编辑">
            </outline>
          </outline>
          <outline text="正向-关闭标签页后重新打开自动恢复缓存">
            <outline text="步骤：填写一半 → 关闭浏览器标签页 → 重新登录进入创建客户表单">
            </outline>
            <outline text="预期：表单自动回填上次填写内容，字段值与关闭前一致（BR-008）">
            </outline>
          </outline>
          <outline text="正向-叉掉表单时提示是否恢复上次版本">
            <outline text="步骤：填写部分内容 → 点击浮层右上角关闭图标 → 再次打开创建表单">
            </outline>
            <outline text="预期：出现「是否需要恢复上次版本」提示；选择恢复后内容回填，选择不恢复则为空白表单">
            </outline>
          </outline>
          <outline text="状态-会话过期后重新登录保留表单数据">
            <outline text="前置：表单已填写完整，登录 token 已失效">
            </outline>
            <outline text="步骤：点击「提交」→ 提示后跳转登录页 → 重新登录">
            </outline>
            <outline text="预期：弹窗提示「登录已过期，请重新登录」；登录成功返回客户列表页，重新打开创建表单时缓存内容仍在">
            </outline>
          </outline>
        </outline>
        <outline text="业务规则与异常">
          <outline text="反向-客户名称重复提交被拦截">
            <outline text="前置：已存在客户「某短视频平台客户」">
            </outline>
            <outline text="步骤：创建同名客户 → 提交并确认">
            </outline>
            <outline text="预期：提示客户已存在并阻止创建，客户总数不变（BR-001）">
            </outline>
            <outline text="备注：PRD 未定义该场景文案，暂按并发冲突文案「客户已存在」预期，见待确认 Q7">
            </outline>
          </outline>
          <outline text="反向-已删除客户的名称可再次创建">
            <outline text="前置：客户「A公司」已被删除">
            </outline>
            <outline text="步骤：创建同名客户「A公司」">
            </outline>
            <outline text="预期：创建成功；唯一性校验范围为「除删除以外的全部客户」（BR-001）">
            </outline>
          </outline>
          <outline text="状态-并发创建同名客户仅先提交者成功">
            <outline text="前置：两个账号各自打开创建表单，客户名称相同">
            </outline>
            <outline text="步骤：账号A 提交成功后 3 秒内账号B 提交">
            </outline>
            <outline text="预期：A 创建成功；B 收到 Toast「客户已存在」，B 侧不产生客户记录（BR-010）">
            </outline>
          </outline>
          <outline text="反向-提交时网络异常保留输入可重试">
            <outline text="步骤：断网状态点击提交 → 恢复网络后重试">
            </outline>
            <outline text="预期：Toast「网络异常，请重试」；表单内容保留；重试后可正常创建成功">
            </outline>
          </outline>
          <outline text="反向-创建接口超10秒提示请求超时">
            <outline text="前置：模拟创建接口响应 12 秒">
            </outline>
            <outline text="步骤：点击提交并确认">
            </outline>
            <outline text="预期：Toast「请求超时，请重试」，输入保留，无重复记录生成">
            </outline>
          </outline>
          <outline text="反向-接口返回500提示系统异常">
            <outline text="前置：模拟创建接口返回 500">
            </outline>
            <outline text="步骤：点击提交并确认">
            </outline>
            <outline text="预期：Toast「系统异常，请稍后重试」；输入保留；后台产生错误日志">
            </outline>
          </outline>
          <outline text="状态-客户系统创建成功但业务中台同步失败用户无感知">
            <outline text="前置：模拟 业务中台 写入接口失败">
            </outline>
            <outline text="步骤：创建客户成功">
            </outline>
            <outline text="预期：前端仍提示「创建成功」，客户系统 客户记录存在且 sync_status=0；生成同步失败日志并进入异步重试队列，用户侧无报错">
            </outline>
          </outline>
          <outline text="反向-必填缺失时滚动至首个未填字段">
            <outline text="步骤：清空客户名称与所属行业 → 点击提交">
            </outline>
            <outline text="预期：两字段均标红，底部提示「请填写客户名称」，页面自动滚动到客户名称字段">
            </outline>
          </outline>
          <outline text="状态-创建成功写入操作日志">
            <outline text="步骤：创建成功后查询操作日志">
            </outline>
            <outline text="预期：日志包含创建人、创建时间、客户名称等关键信息（BR-009）">
            </outline>
          </outline>
          <outline text="状态-客户编号生成后全链路不可修改">
            <outline text="前置：客户已创建，客户编号=KH-202601000001">
            </outline>
            <outline text="步骤：在编辑页、合并审批页、接口入参中查找 客户编号修改入口">
            </outline>
            <outline text="预期：客户编号全程只读；跟进人表、跟进申请单表、历史跟进表关联键仍指向 KH-202601000001，无任何修改入口（BR-011）">
            </outline>
          </outline>
        </outline>
      </outline>
      <outline text="2.2 客户合作状态查询">
        <outline text="查询入口与匹配">
          <outline text="正向-点击查询客户合作状态打开查询对话框">
            <outline text="步骤：客户列表页点击「查询客户合作状态」">
            </outline>
            <outline text="预期：弹出「客户状态查询」对话框，搜索框可输入">
            </outline>
          </outline>
          <outline text="正向-按客户名称模糊匹配命中全部结果">
